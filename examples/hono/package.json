{
  "name": "example-hono",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:css && bun run --hot src/server.ts",
    "build:css": "tailwindcss -i src/style.css -o public/style.css --minify",
    "build": "bun run build:css && bun build src/server.ts --target bun --outdir dist",
    "start": "bun dist/server.js",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "hono": "4.13.9",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "1.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
