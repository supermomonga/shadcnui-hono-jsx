    {
      "name": "theme",
      "type": "registry:item",
      "title": "Theme",
      "description": "shadcn/ui base-nova design tokens, dark mode and custom variants for Tailwind CSS v4.",
      "dependencies": ["tw-animate-css"],
      "files": [
        {
          "path": "styles/shadcn/theme.css",
          "type": "registry:file",
          "target": "~/styles/shadcn/theme.css"
        },
        {
          "path": "styles/shadcn/tailwind.css",
          "type": "registry:file",
          "target": "~/styles/shadcn/tailwind.css"
        },
        {
          "path": "LICENSE-shadcnui-hono-jsx.txt",
          "type": "registry:file",
          "target": "~/LICENSE-shadcnui-hono-jsx.txt"
        }
      ],
      "docs": "Import the theme after Tailwind CSS in your stylesheet: @import \"tailwindcss\"; @import \"<relative path>/styles/shadcn/theme.css\"; and make sure Tailwind scans components/ui (add @source if it is outside your source root).",
      "meta": {
        "upstream": {
          "style": "base-nova",
          "url": "https://ui.shadcn.com/init?base=base&style=nova&baseColor=neutral&theme=neutral&iconLibrary=lucide&font=geist&rtl=false&menuAccent=subtle&menuColor=default&radius=default",
