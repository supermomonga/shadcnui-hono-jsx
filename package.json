{
  "name": "shadcnui-hono-jsx",
  "version": "0.0.0",
  "private": true,
  "description": "shadcn/ui-compatible components for Hono JSX, without React.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome ci .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "verify": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "hono": "4.13.9",
    "ts-morph": "28.0.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  }
}
